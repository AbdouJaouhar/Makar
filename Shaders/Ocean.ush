// Ocean surface functions, called from the Custom nodes of M_Ocean
// (generated by Scripts/create_ocean_material.py). Virtual path: /Makar/Ocean.ush
//
// Texture layout (one pair per cascade, written by AOceanActor):
//   Disp  RGBA = displacement X, Y (horizontal), Z (height) in metres, foam
//   Deriv RGBA = dHeight/dX, dHeight/dY, dDispX/dX, dDispY/dY
// UV = world position (m) / cascade tile size, so the ocean is stable in world space.

#pragma once

float OceanMipLevel(float SpacingM, float PatchSizeM, float Resolution)
{
	const float TexelM = PatchSizeM / Resolution;
	return max(0.0, log2(max(SpacingM / TexelM, 1.0)));
}

// World Position Offset, cm. Only the geometry cascades: finer ones are smaller than a vertex.
float3 OceanVertexOffset(float3 WorldPos, float3 CameraPos,
	Texture2D Disp0, SamplerState Disp0Sampler,
	Texture2D Disp1, SamplerState Disp1Sampler,
	float PatchSize0, float PatchSize1, float Resolution,
	float GridSpacing, float GridInnerHalfWidth, float GridGrowth,
	float FadeStart, float FadeEnd)
{
	const float2 PosM = WorldPos.xy * 0.01;

	// Square grid centred on the camera: Chebyshev distance gives the local vertex spacing exactly.
	const float2 Delta = abs(WorldPos.xy - CameraPos.xy) * 0.01;
	const float DistM = max(Delta.x, Delta.y);
	const float SpacingM = GridSpacing + max(0.0, DistM - GridInnerHalfWidth) * GridGrowth;

	// Pick the mip matching the vertex spacing, otherwise distant vertices alias and shimmer.
	float3 D = Disp0.SampleLevel(Disp0Sampler, PosM / PatchSize0, OceanMipLevel(SpacingM, PatchSize0, Resolution)).xyz
	         + Disp1.SampleLevel(Disp1Sampler, PosM / PatchSize1, OceanMipLevel(SpacingM, PatchSize1, Resolution)).xyz;

	const float Fade = 1.0 - saturate((DistM - FadeStart) / max(FadeEnd - FadeStart, 1.0));
	return D * Fade * 100.0;
}

float2 OceanHash22(float2 P)
{
	const float3 Q = frac(float3(P.xyx) * float3(0.1031, 0.1030, 0.0973));
	const float3 R = Q + dot(Q, Q.yzx + 33.33);
	return frac((R.xx + R.yz) * R.zy);
}

// Distance to the nearest of one random point per cell (Worley F1), ~0 at the points, ~0.7 at cell borders.
float OceanCellular(float2 P)
{
	const float2 Cell = floor(P);
	const float2 Local = P - Cell;
	float Nearest = 8.0;
	for (int Y = -1; Y <= 1; ++Y)
	{
		for (int X = -1; X <= 1; ++X)
		{
			const float2 Offset = float2(X, Y);
			const float2 Delta = Offset + OceanHash22(Cell + Offset) - Local;
			Nearest = min(Nearest, dot(Delta, Delta));
		}
	}
	return sqrt(Nearest);
}

// Foam is a network of bubbles, not a flat white sheet: dense where it was just created,
// a thin lace along bubble borders as it decays. Returns surface coverage in [0, 1].
float OceanFoamCoverage(float2 PosM, float Amount)
{
	// Bubble cells of ~0.8 m and ~0.25 m, attached to the undisplaced surface so they drift with the waves.
	// The large cells are warped by the small ones so the holes are not perfectly round.
	const float Small = OceanCellular(PosM * 4.0);
	const float Large = OceanCellular(PosM * 1.25 + Small * 0.6);
	float Pattern = saturate((Large * 0.45 + Small * 0.55) / 0.7);

	// Average the pattern out where a cell is smaller than a pixel, otherwise distant foam shimmers.
	const float2 Footprint = fwidth(PosM) * 4.0;
	Pattern = lerp(Pattern, 0.55, saturate(max(Footprint.x, Footprint.y) - 0.5));

	// More foam fills more of the pattern: borders first, then whole cells.
	const float Coverage = saturate((Amount * 1.3 - (1.0 - Pattern)) * 4.0);
	// Old, thin foam lets the water show through; fresh whitecaps are opaque.
	return Coverage * lerp(0.55, 1.0, saturate(Amount));
}

// World-space normal from all cascades, plus foam and a crest mask for fake subsurface scattering.
float3 OceanPixel(float3 WorldPos,
	Texture2D Disp0, SamplerState Disp0Sampler,
	Texture2D Disp1, SamplerState Disp1Sampler,
	Texture2D Disp2, SamplerState Disp2Sampler,
	Texture2D Deriv0, SamplerState Deriv0Sampler,
	Texture2D Deriv1, SamplerState Deriv1Sampler,
	Texture2D Deriv2, SamplerState Deriv2Sampler,
	float PatchSize0, float PatchSize1, float PatchSize2, float CrestHeight,
	out float Foam, out float Crest)
{
	const float2 PosM = WorldPos.xy * 0.01;
	const float2 Uv0 = PosM / PatchSize0;
	const float2 Uv1 = PosM / PatchSize1;
	const float2 Uv2 = PosM / PatchSize2;

	const float4 Deriv = Deriv0.Sample(Deriv0Sampler, Uv0)
	                   + Deriv1.Sample(Deriv1Sampler, Uv1)
	                   + Deriv2.Sample(Deriv2Sampler, Uv2);

	// Slope of the displaced surface: height slope divided by the horizontal stretch.
	const float2 Slope = Deriv.xy / max(1.0 + Deriv.zw, 0.2);

	const float4 S0 = Disp0.Sample(Disp0Sampler, Uv0);
	const float4 S1 = Disp1.Sample(Disp1Sampler, Uv1);
	const float4 S2 = Disp2.Sample(Disp2Sampler, Uv2);

	// Whitecaps break on the crests of the larger waves: the 10 m ripple cascade only adds a little,
	// otherwise foam is sprinkled evenly over the whole sea.
	Foam = OceanFoamCoverage(PosM, saturate(S0.w + S1.w * 0.8 + S2.w * 0.15));
	Crest = saturate((S0.z + S1.z) / max(CrestHeight, 0.01));

	return normalize(float3(-Slope, 1.0));
}
