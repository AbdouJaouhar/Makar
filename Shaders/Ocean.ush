// Ocean surface functions, called from the Custom nodes of M_Ocean
// (generated by Scripts/create_ocean_material.py). Virtual path: /Makar/Ocean.ush
//
// Texture layout (one pair per cascade, written by AOceanActor):
//   Disp  RGBA = displacement X, Y (horizontal), Z (height) in metres, foam
//   Deriv RGBA = dHeight/dX, dHeight/dY, dDispX/dX, dDispY/dY
// UV = world position (m) / cascade tile size, so the ocean is stable in world space.

#pragma once

float OceanMipLevel(float SpacingM, float PatchSizeM, float Resolution)
{
	const float TexelM = PatchSizeM / Resolution;
	return max(0.0, log2(max(SpacingM / TexelM, 1.0)));
}

// Coastal data (AOceanBathymetry / FOceanShoreData): RGBA = depth (m, negative on land),
// signed distance to the shore (m, positive at sea), seaward direction XY. ShoreMapSize 0 = no coast.
static const float OceanDeepWaterM = 1000.0;

float4 OceanShoreSample(float2 PosM, Texture2D ShoreMap, SamplerState ShoreMapSampler, float3 ShoreMapOrigin, float ShoreMapSize)
{
	if (ShoreMapSize <= 0.0)
	{
		return float4(OceanDeepWaterM, OceanDeepWaterM, 0.0, 0.0);
	}
	const float2 Uv = (PosM - ShoreMapOrigin.xy) / ShoreMapSize;
	if (any(Uv < 0.0) || any(Uv > 1.0))
	{
		return float4(OceanDeepWaterM, OceanDeepWaterM, 0.0, 0.0);
	}
	return ShoreMap.SampleLevel(ShoreMapSampler, Uv, 0.0);
}

// Waves break once higher than ~0.78 x the depth (McCowan): each cascade is scaled so its significant height
// stays below that. Must match OceanDepthAttenuation in OceanShoreData.h (CPU water queries).
float OceanDepthAttenuation(float DepthM, float SignificantHeightM)
{
	return saturate(0.78 * DepthM / max(SignificantHeightM, 0.01));
}

// Integer hash and lattice value noise, identical to OceanShoreData.cpp (CPU water queries).
uint OceanShoreHash(uint X)
{
	X ^= X >> 16;
	X *= 0x7feb352du;
	X ^= X >> 15;
	X *= 0x846ca68bu;
	X ^= X >> 16;
	return X;
}

float OceanLatticeValue(int X, int Y)
{
	return float(OceanShoreHash(uint(X) * 1597334677u ^ OceanShoreHash(uint(Y)))) / 4294967295.0;
}

float OceanValueNoise(float2 P)
{
	const float2 Cell = floor(P);
	const int X = int(Cell.x);
	const int Y = int(Cell.y);
	const float2 F = P - Cell;
	const float2 U = F * F * (3.0 - 2.0 * F);
	const float Bottom = lerp(OceanLatticeValue(X, Y), OceanLatticeValue(X + 1, Y), U.x);
	const float Top = lerp(OceanLatticeValue(X, Y + 1), OceanLatticeValue(X + 1, Y + 1), U.x);
	return lerp(Bottom, Top, U.y);
}

// Swash on the beach, identical to OceanShoreData.h.
static const float OceanSwashMaxHeightM = 1.5;

float OceanSwashRunup(float SwellHeightM, float Gaps)
{
	return 0.6 * SwellHeightM * Gaps;
}

float OceanSwashRise(float Cycle)
{
	if (Cycle < 0.3)
	{
		return sin(0.5 * PI * Cycle / 0.3);
	}
	return 1.0 - smoothstep(0.0, 1.0, (Cycle - 0.3) / 0.7);
}

float OceanCellular(float2 P); // defined with the foam functions below

// Rounded crown, 1 at a cell's feature point falling smoothly to 0 well before the cell border.
float OceanCrownHeight(float2 P)
{
	const float D = saturate(OceanCellular(P) / 0.55);
	return (1.0 - D * D) * (1.0 - D * D);
}

float2 OceanNoiseGradient(float2 PosM, float Scale);

// Tropical foliage seen from a projection plane P (m): rounded tree crowns ~3 m apart with dark gaps
// (smooth domes, not raw cell distances, whose ridges read as scales) and finer leaf clumps.
// Returns the colour; Bump = height gradient in the plane.
float3 OceanFoliage(float2 P, out float2 Bump)
{
	const float CrownScale = 3.0;
	const float E = 0.15;
	const float C0 = OceanCrownHeight(P / CrownScale);
	const float2 CrownGradient = float2(OceanCrownHeight((P + float2(E, 0.0)) / CrownScale) - C0,
		OceanCrownHeight((P + float2(0.0, E)) / CrownScale) - C0) / E;
	const float Canopy = OceanValueNoise(P / 1.3 + 7.0);
	Bump = CrownGradient * 0.8 + OceanNoiseGradient(P, 0.7) * 0.6;
	return lerp(float3(0.025, 0.055, 0.015), float3(0.1, 0.17, 0.04), Canopy)
		* lerp(0.6, 1.2, OceanValueNoise(P / 9.0 + 17.0)) * lerp(0.6, 1.0, C0);
}

// Gradient of OceanValueNoise(P / Scale), per metre, by forward differences.
float2 OceanNoiseGradient(float2 PosM, float Scale)
{
	const float E = 0.05;
	const float2 P = PosM / Scale;
	const float N = OceanValueNoise(P);
	return float2(OceanValueNoise(P + float2(E, 0.0)) - N, OceanValueNoise(P + float2(0.0, E)) - N) / (E * Scale);
}

// Island terrain and sea floor (M_Seabed): coral sand with wind ripples, wet sand below the swash, dark rock on
// steep ground, low tropical vegetation inland, coral heads and seagrass patches on the shallow floor.
// WorldPos in cm, sea level at Z = 0, VertexNormal in world space. Returns the base colour.
float3 OceanTerrainSurface(float3 WorldPos, float3 VertexNormal, float Time, float SwellHeight, float3 SandColor,
	out float Roughness, out float3 Normal)
{
	const float2 PosM = WorldPos.xy * 0.01;
	const float HeightM = WorldPos.z * 0.01;
	const float Slope = 1.0 - saturate(VertexNormal.z);
	// Detail fades out where it is smaller than a pixel.
	const float Footprint = max(length(fwidth(PosM)), 1e-4);
	const float FineDetail = saturate(1.5 - Footprint / 0.15);
	const float MediumDetail = saturate(1.5 - Footprint / 1.5);

	const float Large = OceanValueNoise(PosM / 40.0);
	const float Medium = OceanValueNoise(PosM / 9.0 + 17.0);
	const float Small = OceanValueNoise(PosM / 2.3 + 41.0);

	// --- Sand: colour patches (shell and coral fragments), wind ripples above water, wave ripples below ---
	float3 Color = SandColor * (0.88 + 0.18 * Large + 0.08 * Medium);
	float2 Bump = 0.0;
	{
		const float2 Warp = 0.6 * float2(Medium, Small);
		const float2 Direction = normalize(float2(0.8, 0.6));
		const float Wavelength = HeightM > 0.0 ? 0.35 : 0.7;
		const float Phase = dot(PosM + Warp, Direction) * (2.0 * PI / Wavelength);
		const float Amplitude = (HeightM > 0.0 ? 0.012 : 0.03) * FineDetail * (0.5 + Large);
		Bump += Direction * (Amplitude * (2.0 * PI / Wavelength) * cos(Phase));
		Bump += OceanNoiseGradient(PosM, 3.0) * 0.08 * MediumDetail; // soft undulations
	}
	Roughness = 0.9;

	// --- Wet sand: soaked and glossy where the swash runs, damp a little higher, a wrack line at the top ---
	if (HeightM > 0.0 && HeightM < OceanSwashMaxHeightM + 0.5)
	{
		const float Gaps = smoothstep(0.35, 0.6, OceanValueNoise(PosM / 60.0 + float2(0.01, 0.007) * Time));
		const float Reach = OceanSwashRunup(SwellHeight, Gaps);
		const float Wet = 1.0 - smoothstep(Reach * 0.6, Reach * 1.2 + 0.05, HeightM);
		const float Damp = 1.0 - smoothstep(Reach * 1.2, Reach * 1.2 + 0.45, HeightM);
		Color *= lerp(1.0, 0.82, Damp) * lerp(1.0, 0.62, Wet);
		Roughness = lerp(Roughness, 0.25, Wet);
		Bump *= 1.0 - 0.8 * Wet; // the water smooths the ripples
		const float Wrack = exp(-pow((HeightM - (Reach * 1.25 + 0.05)) / 0.04, 2.0))
			* smoothstep(0.55, 0.75, OceanValueNoise(PosM / 0.8 + 3.0)) * FineDetail;
		Color = lerp(Color, float3(0.12, 0.1, 0.07), 0.7 * Wrack);
	}

	// --- Coral heads and seagrass on the shallow floor: the dark patches seen through clear lagoon water ---
	if (HeightM < -0.8)
	{
		// Clusters of heads with fuzzy edges, broken up by a finer noise, rather than solid blobs. Rotated and
		// two-octave so the value-noise lattice does not show as an axis-aligned "camouflage" pattern.
		const float2 Rotated = float2(0.8 * PosM.x - 0.6 * PosM.y, 0.6 * PosM.x + 0.8 * PosM.y);
		const float2 Warp = 6.0 * float2(OceanValueNoise(Rotated / 23.0 + 5.0), OceanValueNoise(Rotated / 23.0 + 9.0)) - 3.0;
		const float ClusterNoise = 0.65 * OceanValueNoise((Rotated + Warp) / 11.0 + 23.0)
			+ 0.35 * OceanValueNoise((PosM - Warp) / 4.3 + 31.0);
		const float Cluster = smoothstep(0.52, 0.72, ClusterNoise);
		const float Heads = smoothstep(0.3, 0.65, OceanValueNoise(PosM / 2.2 + 61.0));
		const float Patch = Cluster * lerp(0.35, 1.0, Heads) * smoothstep(-0.8, -2.2, HeightM);
		// Seagrass (dark green), coral rubble and heads (brown to ochre), some paler patches.
		const float3 Seagrass = float3(0.05, 0.075, 0.03);
		const float3 Coral = lerp(float3(0.1, 0.08, 0.05), float3(0.2, 0.16, 0.1), Small);
		const float3 Floor = lerp(Seagrass, Coral, smoothstep(0.35, 0.65, OceanValueNoise(PosM / 30.0 + 77.0)));
		Color = lerp(Color, Floor * (0.75 + 0.5 * Medium), Patch);
		Roughness = lerp(Roughness, 0.95, Patch);
		Bump += OceanNoiseGradient(PosM, 0.8) * 0.3 * Patch * MediumDetail;
	}

	// --- Dark limestone rock on steep ground and rocky points ---
	// Slope = 1 - cos(angle): 0.1 is ~25 degrees, 0.22 ~39 degrees.
	// Only dark boulders at the foot of the coast: higher up, steep slopes are the edge of the forest canopy
	// (a vegetated cliff), which reads as a concrete wall if shaded as rock.
	const float RockMask = smoothstep(0.1, 0.22, Slope + 0.08 * (Medium - 0.5)) * step(-3.0, HeightM)
		* (1.0 - smoothstep(1.8, 3.2, HeightM + 1.2 * (Medium - 0.5)));
	if (RockMask > 0.0)
	{
		const float3 Rock = float3(0.16, 0.145, 0.12) * (0.65 + 0.6 * Small);
		Color = lerp(Color, Rock, RockMask);
		Roughness = lerp(Roughness, 0.8, RockMask);
		Bump += (OceanNoiseGradient(PosM, 1.2) * 0.5 + OceanNoiseGradient(PosM, 4.0) * 0.6) * RockMask * MediumDetail;
	}

	// --- Low tropical vegetation inland, behind the berm ---
	// A wide, ragged transition: scattered scrub on the upper beach, then dense vegetation.
	// Steep ground above the boulders is the forest edge: vegetated, whatever its height.
	const float VegetationLine = HeightM + 1.5 * (Large - 0.5) + 0.8 * (Medium - 0.5)
		+ 4.0 * smoothstep(0.1, 0.2, Slope) * smoothstep(2.0, 3.0, HeightM);
	const float Scrub = smoothstep(1.4, 2.2, VegetationLine) * smoothstep(0.45, 0.7, Small);
	const float Dense = smoothstep(2.0, 3.4, VegetationLine);
	const float Vegetation = saturate(max(Scrub, Dense)) * (1.0 - RockMask * 0.8);
	if (Vegetation > 0.0)
	{
		// Projected from above only, the foliage stretches into vertical streaks on the steep forest edge:
		// triplanar projection on fixed planes (top, XZ, YZ) blended by the normal. Fixed axes, so no swirls.
		float3 Weights = pow(abs(VertexNormal), 4.0);
		Weights /= Weights.x + Weights.y + Weights.z;
		float2 BumpTop, BumpX, BumpY;
		const float3 Green = OceanFoliage(PosM, BumpTop) * Weights.z
			+ OceanFoliage(float2(PosM.y, HeightM) + 31.0, BumpX) * Weights.x
			+ OceanFoliage(float2(PosM.x, HeightM) + 57.0, BumpY) * Weights.y;
		// Horizontal part of each plane's bump: X-facing plane varies along Y, Y-facing plane along X.
		const float2 CrownGradient = BumpTop * Weights.z + float2(0.0, BumpX.x) * Weights.x + float2(BumpY.x, 0.0) * Weights.y;
		const float3 Dry = float3(0.16, 0.15, 0.07); // sun-dried scrub here and there, mostly on the upper beach
		Color = lerp(Color, lerp(Green, Dry, 0.3 * smoothstep(0.6, 0.85, Large) * (1.0 - Dense)), Vegetation);
		Roughness = lerp(Roughness, 0.75, Vegetation);
		Bump += CrownGradient * Vegetation;
	}

	Normal = normalize(VertexNormal - float3(Bump, 0.0));
	return Color;
}

// Swell breaking on the beach, metres; Foam = whitewater 0..1. Mirrors OceanShoreWave in OceanShoreData.cpp
// (see there for the model): crests follow the shore's wave travel time (ShoreMap.z), grow in shallow water,
// pitch forward near the breaking depth and collapse into a bore in the surf zone.
float3 OceanShoreWave(float2 PosM, float Time,
	Texture2D ShoreMap, SamplerState ShoreMapSampler, float3 ShoreMapOrigin, float ShoreMapSize,
	float SwellHeight, float SwellPeriod, float SwellMaxDepth, out float Foam)
{
	Foam = 0.0;
	if (ShoreMapSize <= 0.0 || SwellHeight <= 0.0 || SwellPeriod <= 0.0)
	{
		return 0.0;
	}
	const float4 Here = OceanShoreSample(PosM, ShoreMap, ShoreMapSampler, ShoreMapOrigin, ShoreMapSize);
	const float Depth = Here.x;
	if (Depth >= SwellMaxDepth || Depth < -OceanSwashMaxHeightM)
	{
		return 0.0;
	}

	const float Gaps = smoothstep(0.35, 0.6, OceanValueNoise(PosM / 60.0 + float2(0.01, 0.007) * Time));

	// Swash: the sea surface rises over the beach after each bore and drains back (see the CPU version).
	float3 Result = 0.0;
	{
		const float Runup = OceanSwashRunup(SwellHeight, Gaps);
		const float Cycle = frac((Time + max(Here.z, 0.0)) / SwellPeriod);
		const float Level = Runup * (1.1 * OceanSwashRise(Cycle) - 0.1);
		const float Weight = 1.0 - smoothstep(0.5, 1.5, Depth);
		Result.z = Level * Weight;
		if (Depth < 0.0 && Cycle < 0.6)
		{
			Foam = 0.6 * Gaps * (1.0 - smoothstep(0.0, 0.08, abs(Level + Depth)));
		}
	}

	if (Depth <= 0.02)
	{
		return Result;
	}

	uint Width, Height;
	ShoreMap.GetDimensions(Width, Height);
	const float Step = ShoreMapSize / float(Width);
	const float GradX = (OceanShoreSample(PosM + float2(Step, 0.0), ShoreMap, ShoreMapSampler, ShoreMapOrigin, ShoreMapSize).z - Here.z) / Step;
	const float GradY = (OceanShoreSample(PosM + float2(0.0, Step), ShoreMap, ShoreMapSampler, ShoreMapOrigin, ShoreMapSize).z - Here.z) / Step;
	const float GradLength = sqrt(GradX * GradX + GradY * GradY);
	if (GradLength < 1e-5)
	{
		return Result;
	}
	const float2 TowardShore = float2(-GradX, -GradY) / GradLength;
	const float Phase = 2.0 * PI * (Time + Here.z) / SwellPeriod;
	const float WaveNumber = 2.0 * PI * GradLength / SwellPeriod;

	const float ReferenceDepth = 0.5 * SwellMaxDepth;
	const float Shoaled = SwellHeight * pow(ReferenceDepth / max(Depth, 0.05), 0.25);
	const float Ratio = Shoaled / (0.78 * Depth);
	const float Pitch = smoothstep(0.7, 1.0, Ratio);
	const float Surf = saturate((Ratio - 1.0) / 1.5);
	const float WaveHeight = min(Shoaled, 0.78 * Depth * (1.0 - 0.5 * Surf));

	const float FadeDeep = 1.0 - smoothstep(0.7 * SwellMaxDepth, SwellMaxDepth, Depth);
	const float Amplitude = 0.5 * WaveHeight * FadeDeep * Gaps;

	const float Steepness = lerp(0.5, 1.0, Pitch);
	const float Orbit = min(Steepness / max(WaveNumber, 1e-4), 1.5 * Amplitude);
	const float Crest = 0.5 * (1.0 + cos(Phase));
	const float Lip = Amplitude * Crest * Crest * Crest * (1.2 * Pitch * (1.0 - Surf) + 0.6 * Surf);
	const float Forward = Orbit * sin(Phase) + Lip;

	Foam = max(Foam, FadeDeep * Gaps * max(0.75 * saturate(2.0 * Surf) * smoothstep(0.55, 0.95, Crest),
		0.6 * Pitch * (1.0 - Surf) * smoothstep(0.9, 1.0, Crest)));
	return Result + float3(TowardShore * Forward, Amplitude * cos(Phase));
}

// World Position Offset, cm. Only the geometry cascades: finer ones are smaller than a vertex.
float3 OceanVertexOffset(float3 WorldPos, float3 CameraPos,
	Texture2D Disp0, SamplerState Disp0Sampler,
	Texture2D Disp1, SamplerState Disp1Sampler,
	Texture2D ShoreMap, SamplerState ShoreMapSampler, float3 ShoreMapOrigin, float ShoreMapSize,
	float SignificantHeight0, float SignificantHeight1,
	float Time, float SwellHeight, float SwellPeriod, float SwellMaxDepth,
	float PatchSize0, float PatchSize1, float Resolution,
	float GridSpacing, float GridInnerHalfWidth, float GridGrowth,
	float FadeStart, float FadeEnd)
{
	const float2 PosM = WorldPos.xy * 0.01;
	const float Depth = OceanShoreSample(PosM, ShoreMap, ShoreMapSampler, ShoreMapOrigin, ShoreMapSize).x;

	// Square grid centred on the camera: Chebyshev distance gives the local vertex spacing exactly.
	const float2 Delta = abs(WorldPos.xy - CameraPos.xy) * 0.01;
	const float DistM = max(Delta.x, Delta.y);
	const float SpacingM = GridSpacing + max(0.0, DistM - GridInnerHalfWidth) * GridGrowth;

	// Pick the mip matching the vertex spacing, otherwise distant vertices alias and shimmer.
	float3 D = Disp0.SampleLevel(Disp0Sampler, PosM / PatchSize0, OceanMipLevel(SpacingM, PatchSize0, Resolution)).xyz
	           * OceanDepthAttenuation(Depth, SignificantHeight0)
	         + Disp1.SampleLevel(Disp1Sampler, PosM / PatchSize1, OceanMipLevel(SpacingM, PatchSize1, Resolution)).xyz
	           * OceanDepthAttenuation(Depth, SignificantHeight1);

	float ShoreFoam;
	D += OceanShoreWave(PosM, Time, ShoreMap, ShoreMapSampler, ShoreMapOrigin, ShoreMapSize,
		SwellHeight, SwellPeriod, SwellMaxDepth, ShoreFoam);

	const float Fade = 1.0 - saturate((DistM - FadeStart) / max(FadeEnd - FadeStart, 1.0));
	return D * Fade * 100.0;
}

float2 OceanHash22(float2 P)
{
	const float3 Q = frac(float3(P.xyx) * float3(0.1031, 0.1030, 0.0973));
	const float3 R = Q + dot(Q, Q.yzx + 33.33);
	return frac((R.xx + R.yz) * R.zy);
}

// Distance to the nearest of one random point per cell (Worley F1), ~0 at the points, ~0.7 at cell borders.
float OceanCellular(float2 P)
{
	const float2 Cell = floor(P);
	const float2 Local = P - Cell;
	float Nearest = 8.0;
	for (int Y = -1; Y <= 1; ++Y)
	{
		for (int X = -1; X <= 1; ++X)
		{
			const float2 Offset = float2(X, Y);
			const float2 Delta = Offset + OceanHash22(Cell + Offset) - Local;
			Nearest = min(Nearest, dot(Delta, Delta));
		}
	}
	return sqrt(Nearest);
}

// Foam is a network of bubbles, not a flat white sheet: dense where it was just created,
// a thin lace along bubble borders as it decays. Returns surface coverage in [0, 1].
float OceanFoamCoverage(float2 PosM, float Amount)
{
	// Bubble cells of ~0.8 m and ~0.25 m, attached to the undisplaced surface so they drift with the waves.
	// The large cells are warped by the small ones so the holes are not perfectly round.
	const float Small = OceanCellular(PosM * 4.0);
	const float Large = OceanCellular(PosM * 1.25 + Small * 0.6);
	float Pattern = saturate((Large * 0.45 + Small * 0.55) / 0.7);

	// More foam fills more of the pattern: borders first, then whole cells.
	const float Coverage = saturate((Amount * 1.3 - (1.0 - Pattern)) * 4.0);
	// Old, thin foam lets the water show through; fresh whitecaps are opaque.
	const float Detailed = Coverage * lerp(0.55, 1.0, saturate(Amount));

	// Where the bubble cells are smaller than a pixel the threshold above turns into flat white smears:
	// use the average coverage instead (the fraction of the surface the bubbles would cover).
	const float2 Footprint = fwidth(PosM) * 4.0;
	const float Blur = saturate(max(Footprint.x, Footprint.y) - 0.5);
	return lerp(Detailed, 0.6 * saturate(Amount) * saturate(Amount), Blur);
}

// Animated cell borders: Worley F2 - F1 with feature points orbiting inside their cells.
// Returns ~1 on the borders, 0 inside the cells.
float OceanCausticLayer(float2 P, float Time)
{
	const float2 Cell = floor(P);
	const float2 Local = P - Cell;
	float F1 = 8.0;
	float F2 = 8.0;
	for (int Y = -1; Y <= 1; ++Y)
	{
		for (int X = -1; X <= 1; ++X)
		{
			const float2 Offset = float2(X, Y);
			const float2 Random = OceanHash22(Cell + Offset);
			const float2 Feature = 0.5 + 0.4 * sin(Time * (0.6 + 0.6 * Random) + 6.2831 * Random);
			const float Distance = length(Offset + Feature - Local);
			if (Distance < F1)
			{
				F2 = F1;
				F1 = Distance;
			}
			else
			{
				F2 = min(F2, Distance);
			}
		}
	}
	return 1.0 - smoothstep(0.0, 0.12, F2 - F1);
}

// Light focused on the seabed by the waves: a moving network of bright lines.
// Sea level is Z = 0. Deeper floors get wider, softer and dimmer caustics.
float OceanCaustics(float3 WorldPos, float Time, float CellSizeM, float FadeDepthM)
{
	const float DepthM = max(-WorldPos.z * 0.01, 0.0);
	const float Size = CellSizeM * (1.0 + DepthM * 0.08);
	const float2 PosM = WorldPos.xy * 0.01;

	// Cell borders are straight lines: a slow, smooth warp bends them into the curved filaments
	// that a wavy surface actually focuses.
	float2 P = PosM / Size;
	P += 0.3 * sin(P.yx * float2(1.7, 1.3) + Time * float2(0.4, 0.33));
	P += 0.15 * sin(P.yx * float2(3.1, 2.7) - Time * float2(0.55, 0.47));

	// Two layers drifting in different directions; their product keeps only where lines cross or overlap,
	// which gives the sharp, uneven brightness of real caustics.
	const float A = OceanCausticLayer(P + float2(0.11, 0.05) * Time, Time);
	const float B = OceanCausticLayer(P / 0.83 + float2(-0.07, 0.09) * Time + 17.3, Time * 1.1);
	float Caustics = saturate(A * 0.6 + B * 0.6 + A * B * 0.8);
	Caustics *= Caustics;

	// Average out where the lines are thinner than a pixel; light is absorbed with depth,
	// and nothing above the water line.
	const float2 Footprint = fwidth(PosM / Size);
	const float Blur = saturate(max(Footprint.x, Footprint.y) * 3.0 - 0.5);
	Caustics = lerp(Caustics, 0.25, Blur);
	return Caustics * exp(-DepthM / max(FadeDepthM, 0.1)) * saturate(DepthM / 0.5);
}

// World-space normal from all cascades, plus foam and a crest mask for fake subsurface scattering.
float3 OceanPixel(float3 WorldPos,
	Texture2D Disp0, SamplerState Disp0Sampler,
	Texture2D Disp1, SamplerState Disp1Sampler,
	Texture2D Disp2, SamplerState Disp2Sampler,
	Texture2D Deriv0, SamplerState Deriv0Sampler,
	Texture2D Deriv1, SamplerState Deriv1Sampler,
	Texture2D Deriv2, SamplerState Deriv2Sampler,
	Texture2D Moments0, SamplerState Moments0Sampler,
	Texture2D Moments1, SamplerState Moments1Sampler,
	Texture2D Moments2, SamplerState Moments2Sampler,
	Texture2D FoamMap, SamplerState FoamMapSampler, float3 FoamMapOrigin, float FoamMapSize,
	Texture2D ShoreMap, SamplerState ShoreMapSampler, float3 ShoreMapOrigin, float ShoreMapSize,
	float SignificantHeight0, float SignificantHeight1, float SignificantHeight2,
	float Time, float SwellHeight, float SwellPeriod, float SwellMaxDepth,
	float PatchSize0, float PatchSize1, float PatchSize2, float CrestHeight, float BaseRoughness,
	out float Foam, out float Crest, out float Roughness)
{
	const float2 PosM = WorldPos.xy * 0.01;
	const float2 Uv0 = PosM / PatchSize0;
	const float2 Uv1 = PosM / PatchSize1;
	const float2 Uv2 = PosM / PatchSize2;

	// Shallow water calms each cascade (same factors as the vertex offset and the CPU queries).
	const float Depth = OceanShoreSample(PosM, ShoreMap, ShoreMapSampler, ShoreMapOrigin, ShoreMapSize).x;
	const float A0 = OceanDepthAttenuation(Depth, SignificantHeight0);
	const float A1 = OceanDepthAttenuation(Depth, SignificantHeight1);
	const float A2 = OceanDepthAttenuation(Depth, SignificantHeight2);

	const float4 D0 = Deriv0.Sample(Deriv0Sampler, Uv0) * A0;
	const float4 D1 = Deriv1.Sample(Deriv1Sampler, Uv1) * A1;
	const float4 D2 = Deriv2.Sample(Deriv2Sampler, Uv2) * A2;
	const float4 Deriv = D0 + D1 + D2;

	// LEAN mapping: filtered second moments minus the squared filtered slope is the slope variance of the
	// waves averaged away inside this pixel. Cascades are independent, so their variances add up.
	// Moments are quadratic in the slopes, so they scale with the square of the attenuation.
	const float3 M0 = Moments0.Sample(Moments0Sampler, Uv0).xyz * (A0 * A0);
	const float3 M1 = Moments1.Sample(Moments1Sampler, Uv1).xyz * (A1 * A1);
	const float3 M2 = Moments2.Sample(Moments2Sampler, Uv2).xyz * (A2 * A2);
	const float2 Variance = max(M0.xy - D0.xy * D0.xy, 0.0)
	                      + max(M1.xy - D1.xy * D1.xy, 0.0)
	                      + max(M2.xy - D2.xy * D2.xy, 0.0);

	// Beckmann: alpha^2 = 2 * slope variance (isotropic average), added to the surface's own micro-roughness.
	// Unreal's Roughness is sqrt(alpha). Distant water keeps its glitter instead of turning into a mirror.
	const float BaseAlpha = BaseRoughness * BaseRoughness;
	const float Alpha2 = BaseAlpha * BaseAlpha + (Variance.x + Variance.y);
	Roughness = sqrt(sqrt(Alpha2));

	// Slope of the displaced surface: height slope divided by the horizontal stretch.
	const float2 Slope = Deriv.xy / max(1.0 + Deriv.zw, 0.2);

	const float4 S0 = Disp0.Sample(Disp0Sampler, Uv0);
	const float4 S1 = Disp1.Sample(Disp1Sampler, Uv1);
	const float4 S2 = Disp2.Sample(Disp2Sampler, Uv2);

	// Far away: foam from each cascade's own tile. Whitecaps break on the crests of the larger waves,
	// so the 10 m ripple cascade only adds a little, otherwise foam is sprinkled evenly over the sea.
	float FoamAmount = saturate(S0.w * A0 + S1.w * 0.8 * A1 + S2.w * 0.15 * A2);

	// Around the camera: the simulated foam map (whitecaps of the whole surface, drifting streaks),
	// faded into the tile foam over the outer 10 % of the map.
	if (FoamMapSize > 0.0)
	{
		const float2 MapUv = (PosM - FoamMapOrigin.xy) / FoamMapSize;
		const float2 EdgeDistance = min(MapUv, 1.0 - MapUv);
		const float Inside = saturate(min(EdgeDistance.x, EdgeDistance.y) / 0.1);
		const float MapFoam = FoamMap.Sample(FoamMapSampler, MapUv).r;
		FoamAmount = lerp(FoamAmount, saturate(MapFoam), Inside);
	}
	// Swell breaking on the beach: its normal comes from finite differences of the displaced surface
	// (it can overhang, so slopes alone are not enough); the FFT slopes are added on top.
	float ShoreFoam;
	const float3 W0 = OceanShoreWave(PosM, Time, ShoreMap, ShoreMapSampler, ShoreMapOrigin, ShoreMapSize,
		SwellHeight, SwellPeriod, SwellMaxDepth, ShoreFoam);
	float3 ShoreNormal = float3(0.0, 0.0, 1.0);
	if (any(W0 != 0.0))
	{
		const float Delta = 0.25;
		float Unused;
		const float3 WX = OceanShoreWave(PosM + float2(Delta, 0.0), Time, ShoreMap, ShoreMapSampler, ShoreMapOrigin, ShoreMapSize,
			SwellHeight, SwellPeriod, SwellMaxDepth, Unused);
		const float3 WY = OceanShoreWave(PosM + float2(0.0, Delta), Time, ShoreMap, ShoreMapSampler, ShoreMapOrigin, ShoreMapSize,
			SwellHeight, SwellPeriod, SwellMaxDepth, Unused);
		const float3 TangentX = float3(Delta, 0.0, 0.0) + WX - W0;
		const float3 TangentY = float3(0.0, Delta, 0.0) + WY - W0;
		ShoreNormal = normalize(cross(TangentX, TangentY));
	}

	Foam = OceanFoamCoverage(PosM, max(FoamAmount, ShoreFoam));
	Crest = saturate((S0.z * A0 + S1.z * A1 + W0.z) / max(CrestHeight, 0.01));

	return normalize(ShoreNormal + float3(-Slope, 0.0));
}
