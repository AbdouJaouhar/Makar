#pragma once

// Wind in the island's flora (materials of Scripts/create_flora_materials.py). Virtual path: /Makar/Flora.ush
//
// The trade wind blows steadily from the sea; gusts run through it at the wind's speed, so neighbouring plants bend one
// after the other rather than in unison. Every part of a plant follows the same sway (its bark and its leaves alike, so
// the leaves never come off their twigs); the leaves and the frond tips add a fast flutter on top.

// Towards where the trade wind blows (from the east-north-east, over the windward beaches).
static const float3 FloraWindDirection = float3(-0.97, -0.24, 0.0);

// World position offset (cm). Local = the vertex in its mesh (cm, the plant's foot at the origin): its height and its
// distance from the plant's axis, the same with or without Nanite (whose ObjectPositionWS is the component's, not the
// instance's: leaves hundreds of metres "from their axis" were flung metres away). WorldPos in cm, Time in s.
// Pivot: the plant's foot in the world (its instance's origin): the gusts and the phases are the same over the whole
// plant (taken at each vertex, a gust 30 m long ran along a 5 m frond and the rachis undulated).
// Bend: sway in cm per square metre of height (a plant bends like a cantilever: ~height^2).
// Flutter: cm of fast motion per metre away from the plant's axis (leaves, frond tips); 0 for bark.
float3 FloraWind(float3 WorldPos, float3 Pivot, float3 Local, float4 Frond, float Time, float Bend, float Flutter)
{
	const float Height = max(Local.z, 0.0) * 0.01;
	const float Reach = length(Local.xy) * 0.01;
	// Phases from a field varying slowly over the island (near constant across one plant, which must not tear apart).
	const float2 Coarse = Pivot.xy * 0.0001; // per 100 m
	const float Seed = 0.5 + 0.5 * sin(dot(Coarse, float2(5.3, 3.7)) * 6.2832 + 1.3 * sin(Coarse.x * 4.1));

	// Gusts travelling downwind at ~5 m/s: two incommensurate waves, 0.3..1.
	const float Along = dot(Pivot.xy * 0.01, FloraWindDirection.xy);
	const float Gust = saturate(0.65 + 0.25 * sin(0.21 * Along - 1.05 * Time) + 0.15 * sin(0.083 * Along - 0.41 * Time + 1.7));

	// The sway: leaning downwind with the gust, plus the plant's own slow rocking (~0.3 Hz, its own phase).
	const float Rock = sin(Time * (1.7 + 0.5 * Seed) + 6.2832 * Seed);
	const float Sway = Bend * Height * Height * (0.7 * Gust + 0.3 * Rock * Gust);
	float3 Offset = FloraWindDirection * Sway;
	// Crosswind wobble, a third as large.
	Offset += float3(-FloraWindDirection.y, FloraWindDirection.x, 0.0) * (0.3 * Bend * Height * Height * sin(Time * 1.3 + 4.0 * Seed));

	// Palm fronds (Frond = UV channels 1 and 2, OceanFlora's AddPalmFrond: metres along the rachis, metres along the
	// leaflet, the frond's phase, the leaflet's phase). The rachis is stiff wood: the frond pivots as a whole about where it
	// joins the crown, its displacement growing linearly to its tip (a bend growing as the square of the distance read as
	// elbows along the rachis), pushed downwind and bobbing (~0.6 Hz, its own phase). Each leaflet is stiff along its
	// length and hinged on the rachis: it flaps as a whole, faster (~1.5 Hz), each on its own phase.
	if (any(Frond != 0.0))
	{
		const float Along = Frond.x, Out = Frond.y;
		const float FrondSwing = Time * 3.8 + 6.2832 * Frond.z;
		const float FrondTurn = 5.0 * Along * (0.35 + 0.65 * Gust); // cm per metre: ~20 cm at the tip of a 4.5 m frond
		Offset += FloraWindDirection * (FrondTurn * (0.6 + 0.4 * sin(FrondSwing)))
			+ float3(0.0, 0.0, 0.4 * FrondTurn * sin(FrondSwing + 1.2));
		const float LeafletSwing = Time * (8.5 + 2.0 * Frond.w) + 6.2832 * Frond.w;
		const float Flap = 8.0 * Out * (0.3 + 0.7 * Gust) * sin(LeafletSwing);
		Offset += float3(0.3 * FloraWindDirection.xy * Flap, Flap);
		return Offset;
	}

	// Flutter, stronger in the gusts and further from the axis. Mostly coherent: everything on one side of the plant (one
	// branch) lifts and swings together, its phase set by its direction around the axis, the tips moving the most; plus a
	// small flicker of each leaf on its own phase.
	if (Flutter > 0.0)
	{
		const float2 Around = Local.xy;
		const float Azimuth = atan2(Around.y, Around.x);
		const float Strength = Flutter * (0.25 + Reach) * (0.4 + 0.6 * Gust);
		const float Swing = Time * 2.3 + 3.0 * Azimuth + 6.2832 * Seed;
		Offset += float3(0.35 * sin(Swing) * FloraWindDirection.xy, sin(Swing + 1.1)) * Strength
			+ FloraWindDirection * (0.5 * Strength * (0.5 + 0.5 * sin(Swing * 0.5)));
		const float Phase = dot(WorldPos, float3(0.11, 0.09, 0.13));
		Offset += float3(sin(Time * 9.1 + Phase), cos(Time * 8.3 + 1.3 * Phase), sin(Time * 10.7 + 0.7 * Phase)) * (0.12 * Strength);
	}
	return Offset;
}
