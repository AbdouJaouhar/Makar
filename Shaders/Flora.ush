#pragma once

// Wind in the island's flora (materials of Scripts/create_flora_materials.py). Virtual path: /Makar/Flora.ush
//
// The trade wind blows steadily from the sea; gusts run through it at the wind's speed, so neighbouring plants bend one
// after the other rather than in unison. Every part of a plant follows the same sway (its bark and its leaves alike, so
// the leaves never come off their twigs); the leaves and the frond tips add a fast flutter on top.

// Towards where the trade wind blows (from the east-north-east, over the windward beaches).
static const float3 FloraWindDirection = float3(-0.97, -0.24, 0.0);

// World position offset (cm). Pivot = the instance's position (its foot), WorldPos in cm, Time in s.
// Bend: sway in cm per square metre of height (a plant bends like a cantilever: ~height^2).
// Flutter: cm of fast motion per metre away from the plant's axis (leaves, frond tips); 0 for bark.
float3 FloraWind(float3 WorldPos, float3 Pivot, float Time, float Bend, float Flutter)
{
	const float Height = max(WorldPos.z - Pivot.z, 0.0) * 0.01;
	const float Reach = length(WorldPos.xy - Pivot.xy) * 0.01;
	const float Seed = frac(sin(dot(floor(Pivot.xy), float2(12.9898, 78.233))) * 43758.5453);

	// Gusts travelling downwind at ~5 m/s: two incommensurate waves, 0.3..1.
	const float Along = dot(Pivot.xy * 0.01, FloraWindDirection.xy);
	const float Gust = saturate(0.65 + 0.25 * sin(0.21 * Along - 1.05 * Time) + 0.15 * sin(0.083 * Along - 0.41 * Time + 1.7));

	// The sway: leaning downwind with the gust, plus the plant's own slow rocking (~0.3 Hz, its own phase).
	const float Rock = sin(Time * (1.7 + 0.5 * Seed) + 6.2832 * Seed);
	const float Sway = Bend * Height * Height * (0.7 * Gust + 0.3 * Rock * Gust);
	float3 Offset = FloraWindDirection * Sway;
	// Crosswind wobble, a third as large.
	Offset += float3(-FloraWindDirection.y, FloraWindDirection.x, 0.0) * (0.3 * Bend * Height * Height * sin(Time * 1.3 + 4.0 * Seed));

	// Flutter, stronger in the gusts and further from the axis. Mostly coherent: everything on one side of the plant (one
	// frond, one branch) lifts and swings together, its phase set by its direction around the axis, the tips moving the
	// most; plus a small flicker of each leaf on its own phase (all per-vertex, the fronds snaked like ribbons).
	if (Flutter > 0.0)
	{
		const float2 Around = WorldPos.xy - Pivot.xy;
		const float Azimuth = atan2(Around.y, Around.x);
		const float Strength = Flutter * (0.25 + Reach) * (0.4 + 0.6 * Gust);
		const float Swing = Time * 2.3 + 3.0 * Azimuth + 6.2832 * Seed;
		Offset += float3(0.35 * sin(Swing) * FloraWindDirection.xy, sin(Swing + 1.1)) * Strength
			+ FloraWindDirection * (0.5 * Strength * (0.5 + 0.5 * sin(Swing * 0.5)));
		const float Phase = dot(WorldPos, float3(0.11, 0.09, 0.13));
		Offset += float3(sin(Time * 9.1 + Phase), cos(Time * 8.3 + 1.3 * Phase), sin(Time * 10.7 + 0.7 * Phase)) * (0.12 * Strength);
	}
	return Offset;
}
